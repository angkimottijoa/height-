{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "magic:circle_burst",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/particle/magic_spark"
            }
        },
        "components": {
            "minecraft:emitter_local_space": {
                "position": true,
                "rotation": false,
                "velocity": false
            },
            "minecraft:emitter_rate_instant": {
                "num_particles": 90
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 1.2
            },
            "minecraft:emitter_shape_sphere": {
                "radius": 0.3,
                "offset": [ 0, 0.4, 0 ],
