            },
            "minecraft:particle_initial_speed": "math.random(3.5, 8.0)",
            "minecraft:particle_motion_dynamic": {
                "linear_acceleration": [ 0, -6.0, 0 ],
                "linear_drag_coefficient": 2.2
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "math.random(0.5, 1.1)"
            },
            "minecraft:particle_appearance_billboard": {
                "size": [ 0.11, 0.11 ],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 32,
                    "texture_height": 32,
                    "uv": [ 0, 0 ],
                    "uv_size": [ 32, 32 ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "variable.particle_age / variable.particle_lifetime",
                    "gradient": {
                        "0.0": [ 1.00, 1.00, 1.00, 1.00 ],
                        "0.35": [ 0.70, 0.95, 1.00, 0.90 ],
                        "1.0": [ 0.30, 0.55, 1.00, 0.00 ]
                    }
                }
            }
        }
