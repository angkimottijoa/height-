# Jewel Changi 다이아그리드 - 서 있는 자리 기준 +X/+Z 방향으로 생성
structure load "diagrid:a1" ~ ~ ~
structure load "diagrid:a2" ~ ~ ~64
structure load "diagrid:a3" ~ ~ ~128
structure load "diagrid:a4" ~ ~ ~192
structure load "diagrid:b1" ~64 ~ ~0
structure load "diagrid:b2" ~64 ~ ~64
structure load "diagrid:b3" ~64 ~ ~128
structure load "diagrid:b4" ~64 ~ ~192
structure load "diagrid:c1" ~128 ~ ~0
structure load "diagrid:c2" ~128 ~ ~64
structure load "diagrid:c3" ~128 ~ ~128
structure load "diagrid:c4" ~128 ~ ~192
say §bJewel Changi 다이아그리드 완성!
